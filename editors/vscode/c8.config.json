{
  "all": true,
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.mjs", "*.config.mjs"],
  "exclude": ["node_modules/**"],
  "extension": [".ts", ".mjs"],
  "exclude-after-remap": true,
  "reporter": ["text", "json", "json-summary"],
  "reports-dir": "out/coverage",
  "temp-directory": "out/v8-coverage",
  "check-coverage": true,
  "per-file": true,
  "lines": 100,
  "branches": 100,
  "functions": 100,
  "statements": 100
}
