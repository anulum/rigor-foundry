{
  "name": "rigor-foundry-vscode",
  "displayName": "RigorFoundry Evidence Review",
  "description": "Inspect RigorFoundry audit evidence and validate review ledgers with the canonical CLI.",
  "version": "0.1.0",
  "publisher": "anulum",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/anulum/rigor-foundry.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "audit",
    "evidence",
    "review",
    "rigor"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:rigorFoundry.candidates",
    "onCommand:rigorFoundry.loadReport",
    "onCommand:rigorFoundry.loadReviews",
    "onCommand:rigorFoundry.scanWorkspace",
    "onCommand:rigorFoundry.validateReviews"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension reads repository evidence and may run the configured local RigorFoundry CLI on explicit commands."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "RigorFoundry requires a local Git worktree and local evidence files."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "rigorFoundry.loadReport",
        "title": "RigorFoundry: Load Audit Report"
      },
      {
        "command": "rigorFoundry.loadReviews",
        "title": "RigorFoundry: Load Review Ledger"
      },
      {
        "command": "rigorFoundry.scanWorkspace",
        "title": "RigorFoundry: Scan Workspace"
      },
      {
        "command": "rigorFoundry.validateReviews",
        "title": "RigorFoundry: Validate Review Ledger"
      },
      {
        "command": "rigorFoundry.openEvidence",
        "title": "RigorFoundry: Open Candidate Evidence"
      },
      {
        "command": "rigorFoundry.copyCandidateIdentity",
        "title": "RigorFoundry: Copy Candidate Identity"
      },
      {
        "command": "rigorFoundry.refresh",
        "title": "RigorFoundry: Refresh Evidence View"
      }
    ],
    "configuration": {
      "title": "RigorFoundry",
      "properties": {
        "rigorFoundry.executable": {
          "type": "string",
          "default": "rigor",
          "description": "Absolute path or command name for the RigorFoundry CLI. It is executed without a shell.",
          "scope": "resource"
        },
        "rigorFoundry.reportPath": {
          "type": "string",
          "default": ".rigor/report.json",
          "description": "Workspace-relative path for the audit report.",
          "scope": "resource"
        },
        "rigorFoundry.reviewPath": {
          "type": "string",
          "default": ".rigor/reviews.json",
          "description": "Workspace-relative path for the review ledger.",
          "scope": "resource"
        },
        "rigorFoundry.policyPath": {
          "type": "string",
          "default": "rigor-foundry-policy.json",
          "description": "Workspace-relative policy used by Scan Workspace.",
          "scope": "resource"
        },
        "rigorFoundry.maximumEvidenceBytes": {
          "type": "integer",
          "default": 16777216,
          "minimum": 1024,
          "maximum": 67108864,
          "description": "Maximum UTF-8 bytes accepted for one report or review file.",
          "scope": "resource"
        },
        "rigorFoundry.cliTimeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 1,
          "maximum": 900,
          "description": "Timeout for an explicitly invoked RigorFoundry CLI command.",
          "scope": "resource"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rigorFoundry",
          "title": "RigorFoundry",
          "icon": "media/rigor-foundry.svg"
        }
      ]
    },
    "views": {
      "rigorFoundry": [
        {
          "id": "rigorFoundry.candidates",
          "name": "Audit Evidence"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rigorFoundry.refresh",
          "when": "view == rigorFoundry.candidates",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rigorFoundry.openEvidence",
          "when": "view == rigorFoundry.candidates && viewItem == rigorFoundry.candidate",
          "group": "inline"
        },
        {
          "command": "rigorFoundry.copyCandidateIdentity",
          "when": "view == rigorFoundry.candidates && viewItem == rigorFoundry.candidate",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "check": "npm run clean && npm run lint && npm run format:check && npm run typecheck && npm run compile && npm run docs && npm run test:unit",
    "test:unit": "node --test --test-concurrency=3 out/test/unit/*.test.js",
    "test:integration": "npm run compile && node scripts/run-integration-tests.mjs",
    "vscode:prepublish": "node scripts/stage-package-legal-files.mjs",
    "package": "node scripts/package-linux.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.mjs\" package.json tsconfig.json tsconfig.tools.json typedoc.json c8.config.json README.md",
    "format": "prettier --write \"{src,test,scripts}/**/*.{ts,mjs}\" \"*.mjs\" package.json tsconfig.json tsconfig.tools.json typedoc.json c8.config.json README.md",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "docs": "typedoc --options typedoc.json",
    "test:coverage": "c8 --config c8.config.json npm run verify",
    "verify": "npm run check && npm run test:linux-filesystem && node scripts/run-workspace-tests.mjs && node scripts/run-integration-tests.mjs && node --test out/test/integration/*.test.js",
    "test:linux-filesystem": "node --test out/test/linux/*.test.js",
    "test:workspace": "npm run compile && node scripts/run-workspace-tests.mjs",
    "build:windows-native": "node scripts/build-windows-native.mjs",
    "package:windows": "node scripts/stage-windows-binding.mjs && vsce package --no-dependencies --target win32-x64 --out rigor-foundry-vscode-win32-x64.vsix",
    "stage:windows-native": "node scripts/stage-windows-binding.mjs",
    "test:workbench": "npm run compile && node --test out/test/integration/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "4.0.0",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.6",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "imports": {
    "#cli": {
      "types": "./src/cli.ts",
      "default": "./out/src/cli.js"
    },
    "#test-repository": {
      "types": "./test/support/repository.ts",
      "default": "./out/test/support/repository.js"
    },
    "#koffi-runtime": {
      "types": "koffi",
      "default": "./native/koffi/src/koffi/index.cjs"
    }
  },
  "dependencies": {
    "koffi": "3.3.5"
  }
}
